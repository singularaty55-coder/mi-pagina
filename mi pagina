<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nike Retro Vault - Offers & Promo Codes</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts for Retro Aesthetics -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Rubik+Mono+One&family=VT323&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        .font-pixel { font-family: 'Press Start 2P', monospace; }
        .font-retro-title { font-family: 'Rubik Mono One', sans-serif; }
        .font-arcade { font-family: 'VT323', monospace; }
        .font-body { font-family: 'Space Grotesk', sans-serif; }

        /* Custom Retro Shadows and Borders */
        .retro-border {
            border: 4px solid #000;
            box-shadow: 6px 6px 0px #000;
        }
        .retro-border-sm {
            border: 3px solid #000;
            box-shadow: 4px 4px 0px #000;
        }
        .retro-border-hover:hover {
            transform: translate(-3px, -3px);
            box-shadow: 9px 9px 0px #000;
        }
        .retro-btn-click:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px #000;
        }

        /* Ticket Coupon Cutout Styles */
        .ticket-border {
            border: 4px dashed #000;
            position: relative;
        }
        .ticket-stub-left, .ticket-stub-right {
            content: '';
            position: absolute;
            top: 50%;
            width: 20px;
            height: 20px;
            background-color: #f7f2e4;
            border-radius: 50%;
            border: 3px solid #000;
            transform: translateY(-50%);
        }
        .ticket-stub-left { left: -12px; }
        .ticket-stub-right { right: -12px; }

        /* Scanline Effect */
        .scanlines {
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.15) 50%
            ), linear-gradient(
                90deg,
                rgba(255, 0, 0, 0.03),
                rgba(0, 255, 0, 0.01),
                rgba(0, 0, 255, 0.03)
            );
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 12px;
        }
        ::-webkit-scrollbar-track {
            background: #f1e4c3;
            border-left: 3px solid #000;
        }
        ::-webkit-scrollbar-thumb {
            background: #ff4500;
            border: 2px solid #000;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #e03e00;
        }

        /* Neon Glow Utility */
        .glow-orange {
            text-shadow: 3px 3px 0px #ff4500, 5px 5px 0px #000;
        }
        
        /* Accordion Transition */
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease-out, padding 0.3s ease;
        }
        .accordion-content.open {
            max-height: 600px;
        }

        .sneaker-img {
            filter: contrast(105%) brightness(98%);
            transition: transform 0.4s ease, filter 0.3s ease;
        }
        .sneaker-card:hover .sneaker-img {
            transform: scale(1.08) rotate(-2deg);
        }
    </style>
</head>
<body class="bg-[#f7f2e4] text-black font-body min-h-screen relative overflow-x-hidden">
    <!-- Scanline overlay for CRT display feel -->
    <div class="fixed inset-0 scanlines z-50 pointer-events-none opacity-30"></div>

    <!-- Top Retro Banner -->
