            buttonEl.classList.add('bg-black', 'text-yellow-300');

            setTimeout(() => {
                buttonEl.innerHTML = originalHTML;
                buttonEl.classList.remove('bg-black', 'text-yellow-300');
                buttonEl.classList.add('bg-[#ffdd00]');
            }, 2000);
        }

        // Accordion Toggle
        function toggleAccordion(id, btnElement) {
            playRetroBeep(520, 0.05);
            const content = document.getElementById(id);
            const arrow = btnElement.querySelector('.icon-arrow');
            
            if (content.classList.contains('open')) {
                content.classList.remove('open');
                arrow.style.transform = 'rotate(0deg)';
            } else {
                document.querySelectorAll('.accordion-content').forEach(acc => acc.classList.remove('open'));
                document.querySelectorAll('.icon-arrow').forEach(arr => arr.style.transform = 'rotate(0deg)');
                
                content.classList.add('open');
                arrow.style.transform = 'rotate(90deg)';
            }
        }

        // Open Modal
        function openModal(key) {
            playRetroBeep(650, 0.08);
            const data = sneakerData[key];
            if (!data) return;

            const modal = document.getElementById('retroModal');
            const modalBody = document.getElementById('modalBody');
            const modalHeaderTitle = document.getElementById('modalHeaderTitle');

            modalHeaderTitle.innerText = `SYS_ARCHIVE://${data.name.replace(/\s+/g, '_')}`;

            modalBody.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-black">
                    <div class="bg-white rounded-xl border-4 border-black p-3 relative flex flex-col items-center justify-center shadow-[6px_6px_0px_#000]">
                        <span class="absolute top-2 left-2 font-pixel text-[10px] bg-black text-yellow-300 px-2 py-1 rounded">AÑO ${data.year}</span>
                        <img src="${data.image}" alt="${data.name}" class="w-full h-60 object-contain rounded-lg my-2" onerror="this.src='https://placehold.co/600x400/ff4500/ffffff?text=NIKE'"/>
                        <h4 class="font-retro-title text-lg text-center text-black mt-2">${data.name}</h4>
                        <span class="font-arcade text-xl text-red-600 font-bold">"${data.nickname}"</span>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <h3 class="font-retro-title text-xl text-black mb-1">${data.name}</h3>
                            <p class="font-pixel text-[11px] text-red-600">CREADOR: ${data.designer.toUpperCase()}</p>
                        </div>

                        <div class="bg-white p-3.5 rounded-xl border-2 border-black">
                            <h5 class="font-pixel text-[10px] mb-2 border-b-2 border-black pb-1">RESEÑA Y ORIGEN CULTURAL</h5>
                            <p class="font-body text-xs leading-relaxed">${data.description}</p>
                        </div>

                        <div class="bg-yellow-100 p-3.5 rounded-xl border-2 border-black">
                            <h5 class="font-pixel text-[10px] mb-2 border-b-2 border-black pb-1 text-black">ESPECIFICACIONES DEL MODELO</h5>
                            <ul class="list-disc list-inside font-arcade text-base text-gray-800 space-y-1">
                                ${data.specs.map(spec => `<li>${spec}</li>`).join('')}
                            </ul>
                        </div>

                        <a href="${data.storeUrl}" target="_blank" rel="noopener noreferrer" class="w-full bg-[#00e676] text-black font-pixel text-xs py-3 px-4 rounded-xl retro-border-sm hover:bg-green-400 transition flex items-center justify-center gap-2 text-center">
                            <i class="fa-solid fa-cart-shopping"></i> COMPRAR DIRECTO EN NIKE.COM
                        </a>
                    </div>
                </div>
            `;

            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            playRetroBeep(300, 0.05);
            const modal = document.getElementById('retroModal');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // Like Counter
        function likeSneaker(id, buttonEl) {
            playRetroBeep(880, 0.06);
            const countSpan = buttonEl.querySelector('.like-count');
            let currentLikes = parseInt(countSpan.innerText);
            countSpan.innerText = currentLikes + 1;
            
            buttonEl.classList.add('scale-110');
            setTimeout(() => buttonEl.classList.remove('scale-110'), 150);
        }

        // Filter Category
        function filterCategory(category, btnElement) {
            playRetroBeep(400, 0.04);
            const cards = document.querySelectorAll('.sneaker-card');
            const buttons = document.querySelectorAll('.cat-btn');

            buttons.forEach(btn => {
                btn.classList.remove('bg-black', 'text-white');
                btn.classList.add('bg-white', 'text-black');
            });
            btnElement.classList.remove('bg-white', 'text-black');
            btnElement.classList.add('bg-black', 'text-white');

            cards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Real-Time Search Bar
        function filterSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.sneaker-card');

            cards.forEach(card => {
                const searchData = card.dataset.name || "";
                if (searchData.includes(query)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        window.onclick = function(event) {
            const modal = document.getElementById('retroModal');
            if (event.target === modal) {
                closeModal();
            }
        };
    </script>
</body>
</html>
